<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>lk.aak</groupId>
	<artifactId>aak-agency</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>aak-agency</name>

	<description>
		AAK Agency Distribution Management System
	</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>

		<!-- Web application support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>
				spring-boot-starter-webmvc
			</artifactId>
		</dependency>

		<!-- HTML template support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>
				spring-boot-starter-thymeleaf
			</artifactId>
		</dependency>

		<!-- Database and JPA support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>
				spring-boot-starter-data-jpa
			</artifactId>
		</dependency>

		<!-- Login, logout and application security -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>
				spring-boot-starter-security
			</artifactId>
		</dependency>

		<!-- MySQL database driver -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>
				mysql-connector-j
			</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Thymeleaf testing support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>
				spring-boot-starter-thymeleaf-test
			</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Web testing support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>
				spring-boot-starter-webmvc-test
			</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>

		<plugins>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>
					spring-boot-maven-plugin
				</artifactId>
			</plugin>

		</plugins>

	</build>

</project>